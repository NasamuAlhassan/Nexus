<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget (ui/widget/TalkWidget): one large Talk button and a smaller Look button. Big type (22sp / 18sp, in sp so the
     phone's font size scales it), both at least 72dp tall, opaque. No last answer shown: the home screen is seen by anyone nearby,
     and answers carry balances and messages. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_panel_bg"
    android:padding="8dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_talk"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:minHeight="72dp"
        android:background="@drawable/widget_talk_bg"
        android:drawableStart="@drawable/ic_widget_mic"
        android:drawablePadding="10dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/widget_talk"
        android:contentDescription="@string/widget_talk_description"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_look"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:minHeight="72dp"
        android:background="@drawable/widget_look_bg"
        android:drawableTop="@drawable/ic_widget_camera"
        android:drawablePadding="4dp"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/widget_look"
        android:contentDescription="@string/widget_look_description"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
