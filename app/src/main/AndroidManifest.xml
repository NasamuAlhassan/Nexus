<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet for the cloud agent brain (Gemini). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Phase 2 voice input: capture speech from the microphone (requested at runtime). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- B-07 barge-in: switch to the voice-communication audio mode + loudspeaker for one reply so the echo canceller
         removes our own voice (DuplexAudio). A NORMAL install-time permission — no runtime prompt. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Calls/SMS/phone state are used where the phone has them; tablets and Chromebooks without a radio still install
         the app (the features explain themselves when missing). -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Tier-2 capabilities (requested at runtime). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- W4 phone actions (runtime permissions approved by the owner 2026-09-28; each feature explains itself when one
         is missing and falls back to a no-permission path where one exists). -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- P-01/P-03/P-06: read text, name colours and describe what's in front of the camera (owner approved). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- E-12: install-time, no prompt — Wi-Fi/Bluetooth state queries and the Bluetooth toggle on Android 11. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- B-14: haptic cues (install-time; without it every vibration silently failed). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- A-04: fingerprint-sensor gestures for the accessibility service (install-time). -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- Alarm/timer accelerators (§1.4): without this SET_ALARM is denied and the tool must NOT claim success. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- §C.1 keep the voice session (mic + agent loop) alive while a task is in flight, so the assistant
         doesn't silently die when the screen changes. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required on Android 14+ for the microphone-type foreground services (voice session + wake word). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- §C.1 so a session isn't killed by Doze/battery optimisation; the user grants this in onboarding. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- A-13: re-arm the user's schedules after a reboot (install-time, no prompt). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Draw the Tier-2 confirmation card OVER the app the agent is operating, so the user can
         approve/decline without switching back to Tɛkyerɛma. Optional: degrades to the in-app
         card if not granted. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Needed to resolve/launch other apps and read foreground package on Android 11+.
         Sideload/dev only; a production build would use a scoped <queries> list instead. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".TekyeremaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tekyerema">

        <activity
            android:name=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Tekyerema">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The arrive-on-top voice experience, launched by the accessibility trigger from any app.
             Its own task (empty affinity, single instance, hidden from recents) so that finishing
             it returns the user to whatever they were doing, never to our Home. -->
        <activity
            android:name=".ui.VoiceActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Tekyerema.Voice" />

        <!-- P-03/P-06/P-01 camera reading: its own task so closing it returns to whatever was open.
             No fixed screenOrientation: API 26 crashes when a translucent activity locks orientation. -->
        <activity
            android:name=".camera.CameraReadActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tekyerema.Voice" />

        <!-- A-08 Quick Settings tile: tap to talk; tap again while working to stop (J-14). -->
        <service
            android:name=".voice.TalkTileService"
            android:exported="true"
            android:icon="@drawable/ic_logo_tile"
            android:label="Tɛkyerɛma"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- §C.1 Foreground service that pins the process during an active voice session. -->
        <service
            android:name=".voice.VoiceSessionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Wake-word listening service ("Hey Tɛkyerɛma", on-device trained model). Runs only when enabled + mic granted. -->
        <service
            android:name=".voice.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- The control spine: reads the screen and performs actions. -->
        <service
            android:name=".accessibility.TekyeremaAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- RunGoalReceiver is declared ONLY in the DEBUG manifest (app/src/debug/AndroidManifest.xml),
             exported there for ADB testing. Release builds contain NO such receiver (§1.18): any app
             could otherwise broadcast an extra to approve a pending call/send. -->

        <!-- Reliable read + Direct-Reply path for messaging notifications. -->
        <service
            android:name=".notifications.TekyeremaNotificationListener"
            android:exported="false"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- G-05 the Tɛkyerɛma Twi keyboard (ime/). Exported only to the system (BIND_INPUT_METHOD): the user turns it on in
             the keyboard list and picks it. It runs in the app process (it reads the Secure Input flag), never logs or
             sends what is typed, and has no entry point the agent could use to type. -->
        <service
            android:name=".ime.TwiKeyboardService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- WS-C data export: the user's history + activity log file (cache/exports only) handed to the share sheet with a
             one-off read grant. Not exported; no other app can open anything else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>

        <!-- A-13 schedules (owner-approved unattended triggers): fires the user's own schedules and re-arms them after
             a reboot, an update or a clock change. Not exported — system broadcasts still arrive, no other app can fire one. -->
        <receiver
            android:name=".agent.triggers.TriggerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
