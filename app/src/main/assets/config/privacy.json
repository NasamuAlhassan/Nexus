{
  "schema_version": 1,
  "privacy": {
    "logcatContent": false,
    "retention": { "traceDays": 7, "historyDays": 90, "telemetryDays": 30, "trajectoryDays": 30, "redactTraces": false }
  },
  "telemetry": {
    "enabled": true,
    "maxRecords": 1000,
    "field": { "max": 500 },
    "datasets": { "max": 100, "maxSteps": 40 }
  },
  "pipeline": {
    "budgets": { "asrMs": 1500, "routeMs": 200, "firstDecisionMs": 3500, "ttsStartMs": 800, "responseMs": 4000 }
  },
  "audit": {
    "_maxNote": "WS-C: the structured audit keeps several linked entries per step (proposed, answer, outcome, verification), so the cap is in entries, not tasks.",
    "max": 2000,
    "undo": { "ttlMs": 600000 }
  },
  "memory": {
    "entityIndex": { "ttlDays": 7, "max": 500 }
  }
}
